</hashTree>
<HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="04 PUT update booking" enabled="true">
<boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
<elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" enabled="true">
<collectionProp name="Arguments.arguments">
<elementProp name="" elementType="HTTPArgument"><boolProp name="HTTPArgument.always_encode">false</boolProp>
<stringProp name="Argument.value">{&quot;firstname&quot;:&quot;${__RandomString(6,abcdefghijklmnopqrstuvwxyz)}&quot;,&quot;lastname&quot;:&quot;Load${__RandomString(6,abcdefghijklmnopqrstuvwxyz)}&quot;,&quot;totalprice&quot;:${__Random(100,999)},&quot;depositpaid&quot;:true,&quot;bookingdates&quot;:{&quot;checkin&quot;:&quot;2026-11-01&quot;,&quot;checkout&quot;:&quot;2026-11-05&quot;},&quot;additionalneeds&quot;:&quot;Late checkout&quot;}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp>
</collectionProp>
