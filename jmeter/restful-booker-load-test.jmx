<hashTree/>
<JSONPathAssertion guiclass="JSONPathAssertionGui" testclass="JSONPathAssertion" testname="JSON $.firstname" enabled="true">
<stringProp name="JSON_PATH">$.firstname</stringProp>
<stringProp name="EXPECTED_VALUE"></stringProp>
